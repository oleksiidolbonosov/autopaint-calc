rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidCurrency(c) {
      return c is string && c in ['UAH', 'USD'];
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.email is string && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkshopSettings(data, userId, settingId) {
      return data.keys().hasAll([
          'ownerId', 'id', 'workshopId', 'workshopName', 'locale', 'theme',
          'currentExchangeRate', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'id', 'workshopId', 'workshopName', 'workshopPhone', 'workshopAddress',
          'locale', 'theme', 'currentExchangeRate', 'reminderSnoozedUntil',
          'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.id is string && data.id == 'app_settings' && data.id == settingId
        && isValidId(data.workshopId) && data.workshopId.size() <= 64
        && data.workshopName is string && data.workshopName.size() <= 120
        && (!('workshopPhone' in data) || (data.workshopPhone is string && data.workshopPhone.size() <= 40))
        && (!('workshopAddress' in data) || (data.workshopAddress is string && data.workshopAddress.size() <= 200))
        && data.locale is string && data.locale in ['uk', 'ru']
        && data.theme is string && data.theme in ['light', 'dark', 'system']
        && data.currentExchangeRate is map
        && data.currentExchangeRate.keys().hasAll(['rate', 'source', 'updatedAt'])
        && data.currentExchangeRate.keys().hasOnly(['rate', 'source', 'updatedAt', 'frozenAt'])
        && data.currentExchangeRate.rate is number && data.currentExchangeRate.rate > 0 && data.currentExchangeRate.rate <= 10000
        && data.currentExchangeRate.source is string && data.currentExchangeRate.source in ['nbu', 'manual', 'cached']
        && data.currentExchangeRate.updatedAt is string && data.currentExchangeRate.updatedAt.size() <= 40
        && (!('frozenAt' in data.currentExchangeRate) || (data.currentExchangeRate.frozenAt is string && data.currentExchangeRate.frozenAt.size() <= 40))
        && (!('reminderSnoozedUntil' in data) || (data.reminderSnoozedUntil is string && data.reminderSnoozedUntil.size() <= 40))
        && data.schemaVersion is number && data.schemaVersion >= 1 && data.schemaVersion <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEstimate(data, userId, estimateId) {
      return data.keys().hasAll([
          'ownerId', 'id', 'estimateNumber', 'workshopId', 'schemaVersion',
          'clientCreatedAt', 'clientUpdatedAt', 'orderDate', 'customerName',
          'vehicleType', 'vehicleMake', 'vehicleModel', 'selectedParts',
          'laborItems', 'stages', 'materialsMode', 'quickMaterialMultiplier',
          'quickMaterials', 'detailedMaterials', 'adjustment', 'exchangeRate',
          'totals', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'id', 'estimateNumber', 'workshopId', 'schemaVersion',
          'clientCreatedAt', 'clientUpdatedAt', 'orderDate', 'dueDate',
          'orderPhase', 'preliminaryTotalUah', 'preliminaryLockedAt', 'deposit',
          'customerName', 'customerPhone', 'vehicleType', 'vehicleMake',
          'vehicleModel', 'vehicleYear', 'vehicleColor', 'notes',
          'selectedParts', 'doubleSidedParts', 'laborItems', 'stages', 'materialsMode',
          'quickMaterialMultiplier', 'quickMaterials', 'detailedMaterials',
          'adjustment', 'exchangeRate', 'totals', 'isSample',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.id is string && data.id == estimateId
        && data.estimateNumber is string && data.estimateNumber.size() >= 1 && data.estimateNumber.size() <= 64
        && isValidId(data.workshopId) && data.workshopId.size() <= 64
        && data.schemaVersion is number && data.schemaVersion >= 1 && data.schemaVersion <= 20
        && data.clientCreatedAt is string && data.clientCreatedAt.size() <= 40
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 40
        && data.orderDate is string && data.orderDate.size() <= 20 && data.orderDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 20))
        && (!('orderPhase' in data) || (data.orderPhase is string && data.orderPhase in ['preliminary', 'final']))
        && (!('preliminaryTotalUah' in data) || (data.preliminaryTotalUah is number && data.preliminaryTotalUah >= 0 && data.preliminaryTotalUah <= 100000000))
        && (!('preliminaryLockedAt' in data) || (data.preliminaryLockedAt is string && data.preliminaryLockedAt.size() <= 40))
        && (!('deposit' in data) || (
          data.deposit is map
          && data.deposit.keys().hasAll(['expectedUah', 'receivedUah'])
          && data.deposit.keys().hasOnly(['expectedUah', 'receivedUah', 'receivedAt', 'note'])
          && data.deposit.expectedUah is number && data.deposit.expectedUah >= 0 && data.deposit.expectedUah <= 100000000
          && data.deposit.receivedUah is number && data.deposit.receivedUah >= 0 && data.deposit.receivedUah <= 100000000
          && (!('receivedAt' in data.deposit) || (data.deposit.receivedAt is string && data.deposit.receivedAt.size() <= 40))
          && (!('note' in data.deposit) || (data.deposit.note is string && data.deposit.note.size() <= 300))
        ))
        && data.customerName is string && data.customerName.size() <= 120
        && (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 40))
        && data.vehicleType is string && data.vehicleType in ['car', 'van', 'truck']
        && data.vehicleMake is string && data.vehicleMake.size() <= 80
        && data.vehicleModel is string && data.vehicleModel.size() <= 80
        && (!('vehicleYear' in data) || (data.vehicleYear is string && data.vehicleYear.size() <= 12))
        && (!('vehicleColor' in data) || (data.vehicleColor is string && data.vehicleColor.size() <= 80))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1500))
        && data.selectedParts is list && data.selectedParts.size() <= 60
        && (data.selectedParts.size() == 0 || data.selectedParts[0] is string)
        && (!('doubleSidedParts' in data) || (
          data.doubleSidedParts is list && data.doubleSidedParts.size() <= 60
          && (data.doubleSidedParts.size() == 0 || data.doubleSidedParts[0] is string)
        ))
        && data.laborItems is list && data.laborItems.size() <= 250
        && (data.laborItems.size() == 0 || data.laborItems[0] is map)
        && data.stages is list && data.stages.size() <= 12
        && (data.stages.size() == 0 || data.stages[0] is map)
        && data.materialsMode is string && data.materialsMode in ['quick', 'detailed']
        && data.quickMaterialMultiplier is number && data.quickMaterialMultiplier >= 0.1 && data.quickMaterialMultiplier <= 20
        && data.quickMaterials is list && data.quickMaterials.size() <= 150
        && (data.quickMaterials.size() == 0 || data.quickMaterials[0] is map)
        && data.detailedMaterials is list && data.detailedMaterials.size() <= 150
        && (data.detailedMaterials.size() == 0 || data.detailedMaterials[0] is map)
        && data.adjustment is map
        && data.adjustment.keys().hasAll(['kind', 'valueType', 'value'])
        && data.adjustment.keys().hasOnly(['kind', 'valueType', 'value'])
        && data.adjustment.kind is string && data.adjustment.kind in ['none', 'discount', 'markup']
        && data.adjustment.valueType is string && data.adjustment.valueType in ['percent', 'fixed_uah']
        && data.adjustment.value is number
        && data.exchangeRate is map
        && data.exchangeRate.keys().hasAll(['rate', 'source', 'updatedAt'])
        && data.exchangeRate.keys().hasOnly(['rate', 'source', 'updatedAt', 'frozenAt'])
        && data.exchangeRate.rate is number && data.exchangeRate.rate > 0 && data.exchangeRate.rate <= 10000
        && data.exchangeRate.source is string && data.exchangeRate.source in ['nbu', 'manual', 'cached']
        && data.exchangeRate.updatedAt is string && data.exchangeRate.updatedAt.size() <= 40
        && (!('frozenAt' in data.exchangeRate) || (data.exchangeRate.frozenAt is string && data.exchangeRate.frozenAt.size() <= 40))
        && data.totals is map
        && data.totals.keys().hasAll([
          'laborSubtotalUah', 'materialsSubtotalUah', 'subtotalBeforeAdjustmentUah',
          'adjustmentAmountUah', 'totalUah'
        ])
        && data.totals.keys().hasOnly([
          'laborSubtotalUah', 'materialsSubtotalUah', 'subtotalBeforeAdjustmentUah',
          'adjustmentAmountUah', 'totalUah'
        ])
        && data.totals.laborSubtotalUah is number
        && data.totals.materialsSubtotalUah is number
        && data.totals.subtotalBeforeAdjustmentUah is number
        && data.totals.adjustmentAmountUah is number
        && data.totals.totalUah is number
        && (!('isSample' in data) || data.isSample is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMaterialCatalogItem(data, userId, materialId) {
      return data.keys().hasAll([
          'ownerId', 'id', 'workshopId', 'name', 'category',
          'packageSize', 'packageUnit', 'packagePrice', 'currency',
          'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'id', 'workshopId', 'name', 'category',
          'packageSize', 'packageUnit', 'packagePrice', 'currency',
          'isCustom', 'isSample', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.id is string && data.id == materialId
        && isValidId(data.workshopId) && data.workshopId.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.category is string && data.category in [
          'basecoat', 'clearcoat', 'primer', 'filler', 'hardener',
          'thinner', 'sandpaper', 'masking', 'other'
        ]
        && data.packageSize is number && data.packageSize > 0
        && data.packageUnit is string && data.packageUnit in ['g', 'kg', 'ml', 'l', 'pcs']
        && data.packagePrice is number && data.packagePrice >= 0
        && isValidCurrency(data.currency)
        && (!('isCustom' in data) || data.isCustom is bool)
        && (!('isSample' in data) || data.isSample is bool)
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMasterLaborOperation(data, userId, operationId) {
      return data.keys().hasAll([
          'ownerId', 'id', 'workshopId', 'operationType',
          'basePrice', 'currency', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'id', 'workshopId', 'operationType', 'customName',
          'basePrice', 'currency', 'isSample', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.id is string && data.id == operationId
        && isValidId(data.workshopId) && data.workshopId.size() <= 64
        && data.operationType is string && data.operationType in [
          'removal', 'installation', 'disassembly', 'assembly', 'surface_prep',
          'painting', 'dent_repair', 'plastic_repair', 'polishing', 'custom'
        ]
        && (!('customName' in data) || (data.customName is string && data.customName.size() <= 140))
        && data.basePrice is number && data.basePrice >= 0
        && isValidCurrency(data.currency)
        && (!('isSample' in data) || data.isSample is bool)
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartQuickTemplate(data, userId, partId) {
      return data.keys().hasAll([
          'ownerId', 'partId', 'workshopId', 'rules', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'partId', 'workshopId', 'rules', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.partId is string && data.partId == partId && data.partId.size() <= 64
        && isValidId(data.workshopId) && data.workshopId.size() <= 64
        && data.rules is list && data.rules.size() <= 50
        && (data.rules.size() == 0 || data.rules[0] is map)
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isSignedIn()
        && isVerified()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isVerified()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
        && (
          ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
          || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
        )
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt'])
          || (
            (!('ownerId' in existing()) || !('createdAt' in existing()) || !(existing().createdAt is timestamp))
            && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId', 'email', 'displayName', 'createdAt', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /settings/{settingId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(settingId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && isValidWorkshopSettings(incoming(), userId, settingId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && isValidWorkshopSettings(incoming(), userId, settingId)
          && hasUserProfile(userId)
          && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
          && (!('id' in existing()) || incoming().id == existing().id)
          && (
            ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
            || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
          )
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workshopId', 'workshopName', 'workshopPhone', 'workshopAddress',
              'locale', 'theme', 'currentExchangeRate', 'reminderSnoozedUntil',
              'schemaVersion', 'updatedAt'
            ])
            || (
              (!('createdAt' in existing()) || !(existing().createdAt is timestamp))
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'workshopId', 'workshopName', 'workshopPhone', 'workshopAddress',
                'locale', 'theme', 'currentExchangeRate', 'reminderSnoozedUntil',
                'schemaVersion', 'createdAt', 'updatedAt'
              ])
            )
          );
        allow delete: if false;
      }

      match /estimates/{estimateId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(estimateId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(estimateId)
          && isValidEstimate(incoming(), userId, estimateId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(estimateId)
          && isValidEstimate(incoming(), userId, estimateId)
          && hasUserProfile(userId)
          && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
          && (!('id' in existing()) || incoming().id == existing().id)
          && (!('clientCreatedAt' in existing()) || !(existing().clientCreatedAt is string) || existing().clientCreatedAt.size() == 0 || incoming().clientCreatedAt == existing().clientCreatedAt)
          && (
            ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
            || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
          )
          && incoming().updatedAt == request.time
          && (
            // Action: Full order / estimate update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'estimateNumber', 'workshopId', 'schemaVersion',
              'clientUpdatedAt', 'orderDate', 'dueDate',
              'orderPhase', 'preliminaryTotalUah', 'preliminaryLockedAt', 'deposit',
              'customerName', 'customerPhone', 'vehicleType', 'vehicleMake',
              'vehicleModel', 'vehicleYear', 'vehicleColor', 'notes',
              'selectedParts', 'doubleSidedParts', 'laborItems', 'stages', 'materialsMode',
              'quickMaterialMultiplier', 'quickMaterials', 'detailedMaterials',
              'adjustment', 'exchangeRate', 'totals', 'isSample', 'updatedAt'
            ])
            ||
            // Action: Legacy estimate repair (populates missing createdAt / clientCreatedAt / ownerId / id)
            (
              (!('createdAt' in existing()) || !(existing().createdAt is timestamp) || !('clientCreatedAt' in existing()) || !(existing().clientCreatedAt is string) || existing().clientCreatedAt.size() == 0 || !('ownerId' in existing()) || !('id' in existing()))
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'ownerId', 'id', 'estimateNumber', 'workshopId', 'schemaVersion',
                'clientCreatedAt', 'clientUpdatedAt', 'orderDate', 'dueDate',
                'orderPhase', 'preliminaryTotalUah', 'preliminaryLockedAt', 'deposit',
                'customerName', 'customerPhone', 'vehicleType', 'vehicleMake',
                'vehicleModel', 'vehicleYear', 'vehicleColor', 'notes',
                'selectedParts', 'doubleSidedParts', 'laborItems', 'stages', 'materialsMode',
                'quickMaterialMultiplier', 'quickMaterials', 'detailedMaterials',
                'adjustment', 'exchangeRate', 'totals', 'isSample', 'createdAt', 'updatedAt'
              ])
            )
            ||
            // Action: Quick workflow stage toggle
            incoming().diff(existing()).affectedKeys().hasOnly([
              'stages', 'clientUpdatedAt', 'updatedAt'
            ])
            ||
            // Action: Quick deposit or order phase update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'deposit', 'orderPhase', 'preliminaryTotalUah', 'preliminaryLockedAt',
              'clientUpdatedAt', 'updatedAt'
            ])
          );
        allow delete: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(estimateId);
      }

      match /materials/{materialId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(materialId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(materialId)
          && isValidMaterialCatalogItem(incoming(), userId, materialId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(materialId)
          && isValidMaterialCatalogItem(incoming(), userId, materialId)
          && hasUserProfile(userId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'workshopId', 'name', 'category', 'packageSize', 'packageUnit',
            'packagePrice', 'currency', 'isCustom', 'isSample', 'clientUpdatedAt', 'updatedAt'
          ]);
        allow delete: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(materialId);
      }

      match /laborPrices/{operationId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(operationId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(operationId)
          && isValidMasterLaborOperation(incoming(), userId, operationId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(operationId)
          && isValidMasterLaborOperation(incoming(), userId, operationId)
          && hasUserProfile(userId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'workshopId', 'operationType', 'customName', 'basePrice',
            'currency', 'isSample', 'clientUpdatedAt', 'updatedAt'
          ]);
        allow delete: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(operationId);
      }

      match /partTemplates/{partId} {
        allow get: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(partId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(partId)
          && isValidPartQuickTemplate(incoming(), userId, partId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(partId)
          && isValidPartQuickTemplate(incoming(), userId, partId)
          && hasUserProfile(userId)
          && incoming().ownerId == existing().ownerId
          && incoming().partId == existing().partId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'workshopId', 'rules', 'clientUpdatedAt', 'updatedAt'
          ]);
        allow delete: if isSignedIn()
          && isVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(partId);
      }
    }
  }
}
