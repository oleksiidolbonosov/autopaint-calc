rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidShortId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function hasUserProfile(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidCurrency(c) {
      return c in ['UAH', 'USD'];
    }

    function isValidExchangeRateMap(rate) {
      let frozenAt = rate.get('frozenAt', '');
      return rate is map
        && rate.keys().hasOnly(['rate', 'source', 'updatedAt', 'frozenAt'])
        && rate.rate is number && rate.rate > 0 && rate.rate <= 10000
        && rate.source in ['nbu', 'manual', 'cached']
        && rate.updatedAt is string && rate.updatedAt.size() <= 40
        && frozenAt is string && frozenAt.size() <= 40;
    }

    function isValidDepositMap(dep) {
      let receivedAt = dep.get('receivedAt', '');
      let note = dep.get('note', '');
      return dep is map
        && dep.keys().hasOnly(['expectedUah', 'receivedUah', 'receivedAt', 'note'])
        && dep.expectedUah is number && dep.expectedUah >= 0 && dep.expectedUah <= 100000000
        && dep.receivedUah is number && dep.receivedUah >= 0 && dep.receivedUah <= 100000000
        && receivedAt is string && receivedAt.size() <= 40
        && note is string && note.size() <= 300;
    }

    function isValidAdjustmentMap(adj) {
      let k = adj.keys();
      let req = ['kind', 'valueType', 'value'];
      return adj is map
        && k.size() == 3
        && k.hasAll(req)
        && adj.kind in ['none', 'discount', 'markup']
        && adj.valueType in ['percent', 'fixed_uah']
        && adj.value is number;
    }

    function isValidTotalsMap(tot) {
      let k = tot.keys();
      let req = [
        'laborSubtotalUah', 'materialsSubtotalUah', 'subtotalBeforeAdjustmentUah',
        'adjustmentAmountUah', 'totalUah'
      ];
      return tot is map
        && k.size() == 5
        && k.hasAll(req)
        && tot.laborSubtotalUah is number
        && tot.materialsSubtotalUah is number
        && tot.subtotalBeforeAdjustmentUah is number
        && tot.adjustmentAmountUah is number
        && tot.totalUah is number;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      let k = data.keys();
      let req = ['ownerId', 'email', 'displayName', 'createdAt', 'updatedAt'];
      return k.size() == 5
        && k.hasAll(req)
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.email is string && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkshopSettings(data, userId, settingId) {
      let k = data.keys();
      let phone = data.get('workshopPhone', '');
      let addr = data.get('workshopAddress', '');
      let snooze = data.get('reminderSnoozedUntil', '');
      return k.hasAll([
          'ownerId', 'id', 'workshopId', 'workshopName', 'locale', 'theme',
          'currentExchangeRate', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && k.hasOnly([
          'ownerId', 'id', 'workshopId', 'workshopName', 'workshopPhone', 'workshopAddress',
          'locale', 'theme', 'currentExchangeRate', 'reminderSnoozedUntil',
          'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.id is string && data.id == 'app_settings' && data.id == settingId
        && isValidShortId(data.workshopId)
        && data.workshopName is string && data.workshopName.size() <= 120
        && phone is string && phone.size() <= 40
        && addr is string && addr.size() <= 200
        && data.locale in ['uk', 'ru']
        && data.theme in ['light', 'dark', 'system']
        && isValidExchangeRateMap(data.currentExchangeRate)
        && snooze is string && snooze.size() <= 40
        && data.schemaVersion is number && data.schemaVersion >= 1 && data.schemaVersion <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEstimateOptionals(data) {
      let dueDate = data.get('dueDate', '');
      let prelimTotal = data.get('preliminaryTotalUah', 0);
      let prelimAt = data.get('preliminaryLockedAt', '');
      let phone = data.get('customerPhone', '');
      let vYear = data.get('vehicleYear', '');
      let vColor = data.get('vehicleColor', '');
      let notes = data.get('notes', '');
      return dueDate is string && dueDate.size() <= 20
        && data.get('orderPhase', 'preliminary') in ['preliminary', 'final']
        && prelimTotal is number && prelimTotal >= 0 && prelimTotal <= 100000000
        && prelimAt is string && prelimAt.size() <= 40
        && (!('deposit' in data) || isValidDepositMap(data.deposit))
        && phone is string && phone.size() <= 40
        && vYear is string && vYear.size() <= 12
        && vColor is string && vColor.size() <= 80
        && notes is string && notes.size() <= 1500
        && data.get('isSample', false) is bool;
    }

    function isValidEstimate(data, userId, estimateId) {
      let parts = data.selectedParts;
      let dParts = data.get('doubleSidedParts', []);
      let labor = data.laborItems;
      let stages = data.stages;
      let qMats = data.quickMaterials;
      let dMats = data.detailedMaterials;
      return data.keys().hasOnly([
          'ownerId', 'id', 'estimateNumber', 'workshopId', 'schemaVersion',
          'clientCreatedAt', 'clientUpdatedAt', 'orderDate', 'dueDate',
          'orderPhase', 'preliminaryTotalUah', 'preliminaryLockedAt', 'deposit',
          'customerName', 'customerPhone', 'vehicleType', 'vehicleMake',
          'vehicleModel', 'vehicleYear', 'vehicleColor', 'notes',
          'selectedParts', 'doubleSidedParts', 'laborItems', 'stages', 'materialsMode',
          'quickMaterialMultiplier', 'quickMaterials', 'detailedMaterials',
          'adjustment', 'exchangeRate', 'totals', 'isSample',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == userId
        && data.id == estimateId
        && data.estimateNumber is string && data.estimateNumber.size() >= 1 && data.estimateNumber.size() <= 64
        && isValidShortId(data.workshopId)
        && data.schemaVersion is number && data.schemaVersion >= 1 && data.schemaVersion <= 20
        && data.clientCreatedAt is string && data.clientCreatedAt.size() >= 1 && data.clientCreatedAt.size() <= 40
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() >= 1 && data.clientUpdatedAt.size() <= 40
        && data.orderDate is string && data.orderDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.customerName is string && data.customerName.size() <= 120
        && data.vehicleType in ['car', 'van', 'truck']
        && data.vehicleMake is string && data.vehicleMake.size() <= 80
        && data.vehicleModel is string && data.vehicleModel.size() <= 80
        && parts is list && parts.size() <= 60 && (parts.size() == 0 || parts[0] is string)
        && dParts is list && dParts.size() <= 60 && (dParts.size() == 0 || dParts[0] is string)
        && labor is list && labor.size() <= 250
        && stages is list && stages.size() <= 12
        && data.materialsMode in ['quick', 'detailed']
        && data.quickMaterialMultiplier is number && data.quickMaterialMultiplier >= 0.1 && data.quickMaterialMultiplier <= 20
        && qMats is list && qMats.size() <= 150
        && dMats is list && dMats.size() <= 150
        && isValidAdjustmentMap(data.adjustment)
        && isValidExchangeRateMap(data.exchangeRate)
        && isValidTotalsMap(data.totals)
        && isValidEstimateOptionals(data)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEstimateUpdatePayload(next, prev) {
      let hasOwner = 'ownerId' in prev;
      let hasId = 'id' in prev;
      let prevCAt = prev.get('clientCreatedAt', '');
      let hasCAt = prevCAt is string && prevCAt.size() > 0;
      let hasCreated = prev.get('createdAt', null) is timestamp;
      return (!hasOwner || next.ownerId == prev.ownerId)
        && (!hasId || next.id == prev.id)
        && (!hasCAt || next.clientCreatedAt == prevCAt)
        && ((hasCreated && next.createdAt == prev.createdAt) || (!hasCreated && next.createdAt == request.time))
        && next.updatedAt == request.time;
    }

    function isValidMaterialCatalogItem(data, userId, materialId) {
      let k = data.keys();
      return k.hasAll([
          'ownerId', 'id', 'workshopId', 'name', 'category',
          'packageSize', 'packageUnit', 'packagePrice', 'currency',
          'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && k.hasOnly([
          'ownerId', 'id', 'workshopId', 'name', 'category',
          'packageSize', 'packageUnit', 'packagePrice', 'currency',
          'isCustom', 'isSample', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.id is string && data.id == materialId
        && isValidShortId(data.workshopId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.category in [
          'basecoat', 'clearcoat', 'primer', 'filler', 'hardener',
          'thinner', 'sandpaper', 'masking', 'other'
        ]
        && data.packageSize is number && data.packageSize > 0
        && data.packageUnit in ['g', 'kg', 'ml', 'l', 'pcs']
        && data.packagePrice is number && data.packagePrice >= 0
        && isValidCurrency(data.currency)
        && data.get('isCustom', false) is bool
        && data.get('isSample', false) is bool
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMasterLaborOperation(data, userId, operationId) {
      let k = data.keys();
      let customName = data.get('customName', '');
      return k.hasAll([
          'ownerId', 'id', 'workshopId', 'operationType',
          'basePrice', 'currency', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && k.hasOnly([
          'ownerId', 'id', 'workshopId', 'operationType', 'customName',
          'basePrice', 'currency', 'isSample', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && data.id is string && data.id == operationId
        && isValidShortId(data.workshopId)
        && data.operationType in [
          'removal', 'installation', 'disassembly', 'assembly', 'surface_prep',
          'painting', 'dent_repair', 'plastic_repair', 'polishing', 'custom'
        ]
        && customName is string && customName.size() <= 140
        && data.basePrice is number && data.basePrice >= 0
        && isValidCurrency(data.currency)
        && data.get('isSample', false) is bool
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartQuickTemplate(data, userId, partId) {
      let k = data.keys();
      let req = ['ownerId', 'partId', 'workshopId', 'rules', 'clientUpdatedAt', 'createdAt', 'updatedAt'];
      let rulesList = data.rules;
      return k.hasAll(req)
        && k.hasOnly(req)
        && data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId
        && isValidShortId(data.partId) && data.partId == partId
        && isValidShortId(data.workshopId)
        && rulesList is list && rulesList.size() <= 50
        && (rulesList.size() == 0 || rulesList[0] is map)
        && data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
        && (
          ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
          || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
        )
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt'])
          || (
            (!('ownerId' in existing()) || !('createdAt' in existing()) || !(existing().createdAt is timestamp))
            && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId', 'email', 'displayName', 'createdAt', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(settingId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && isValidWorkshopSettings(incoming(), userId, settingId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(settingId)
          && isValidWorkshopSettings(incoming(), userId, settingId)
          && hasUserProfile(userId)
          && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
          && (!('id' in existing()) || incoming().id == existing().id)
          && (
            ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
            || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
          )
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workshopId', 'workshopName', 'workshopPhone', 'workshopAddress',
              'locale', 'theme', 'currentExchangeRate', 'reminderSnoozedUntil',
              'schemaVersion', 'updatedAt'
            ])
            || (
              (!('ownerId' in existing()) || !('id' in existing()) || !('createdAt' in existing()) || !(existing().createdAt is timestamp))
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'ownerId', 'id', 'workshopId', 'workshopName', 'workshopPhone', 'workshopAddress',
                'locale', 'theme', 'currentExchangeRate', 'reminderSnoozedUntil',
                'schemaVersion', 'createdAt', 'updatedAt'
              ])
            )
          );
        allow delete: if false;
      }

      match /estimates/{estimateId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(estimateId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(estimateId)
          && isValidEstimate(incoming(), userId, estimateId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(estimateId)
          && isValidEstimate(incoming(), userId, estimateId)
          && hasUserProfile(userId)
          && isValidEstimateUpdatePayload(incoming(), existing());
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(estimateId);
      }

      match /materials/{materialId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(materialId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(materialId)
          && isValidMaterialCatalogItem(incoming(), userId, materialId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(materialId)
          && isValidMaterialCatalogItem(incoming(), userId, materialId)
          && hasUserProfile(userId)
          && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
          && (!('id' in existing()) || incoming().id == existing().id)
          && (
            ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
            || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
          )
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workshopId', 'name', 'category', 'packageSize', 'packageUnit',
              'packagePrice', 'currency', 'isCustom', 'isSample', 'clientUpdatedAt', 'updatedAt'
            ])
            || (
              (!('ownerId' in existing()) || !('id' in existing()) || !('createdAt' in existing()) || !(existing().createdAt is timestamp))
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'ownerId', 'id', 'workshopId', 'name', 'category', 'packageSize', 'packageUnit',
                'packagePrice', 'currency', 'isCustom', 'isSample', 'clientUpdatedAt', 'createdAt', 'updatedAt'
              ])
            )
          );
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(materialId);
      }

      match /laborPrices/{operationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(operationId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(operationId)
          && isValidMasterLaborOperation(incoming(), userId, operationId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(operationId)
          && isValidMasterLaborOperation(incoming(), userId, operationId)
          && hasUserProfile(userId)
          && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
          && (!('id' in existing()) || incoming().id == existing().id)
          && (
            ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
            || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
          )
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workshopId', 'operationType', 'customName', 'basePrice',
              'currency', 'isSample', 'clientUpdatedAt', 'updatedAt'
            ])
            || (
              (!('ownerId' in existing()) || !('id' in existing()) || !('createdAt' in existing()) || !(existing().createdAt is timestamp))
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'ownerId', 'id', 'workshopId', 'operationType', 'customName', 'basePrice',
                'currency', 'isSample', 'clientUpdatedAt', 'createdAt', 'updatedAt'
              ])
            )
          );
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(operationId);
      }

      match /partTemplates/{partId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(partId);
        allow list: if isSignedIn() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(partId)
          && isValidPartQuickTemplate(incoming(), userId, partId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserProfile(userId);
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(partId)
          && isValidPartQuickTemplate(incoming(), userId, partId)
          && hasUserProfile(userId)
          && (!('ownerId' in existing()) || incoming().ownerId == existing().ownerId)
          && (!('partId' in existing()) || incoming().partId == existing().partId)
          && (
            ('createdAt' in existing() && existing().createdAt is timestamp && incoming().createdAt == existing().createdAt)
            || ((!('createdAt' in existing()) || !(existing().createdAt is timestamp)) && incoming().createdAt == request.time)
          )
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'workshopId', 'rules', 'clientUpdatedAt', 'updatedAt'
            ])
            || (
              (!('ownerId' in existing()) || !('partId' in existing()) || !('createdAt' in existing()) || !(existing().createdAt is timestamp))
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'ownerId', 'partId', 'workshopId', 'rules', 'clientUpdatedAt', 'createdAt', 'updatedAt'
              ])
            )
          );
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(partId);
      }
    }
  }
}
